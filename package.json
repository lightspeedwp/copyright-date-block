{
	"name": "copyright-date-block",
	"version": "0.1.0",
	"description": "Display your site's copyright date.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"format": "wp-scripts format",
		"lint": "npm run lint:js && npm run lint:php",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer run-script phpcs",
		"lint:fix": "npm run lint:js -- --fix && npm run lint:php:fix",
		"lint:php:fix": "composer run-script phpcbf",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "husky",
		"start": "wp-scripts start --blocks-manifest",
		"test": "wp-scripts test-unit-js",
		"env": "wp-env"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"devDependencies": {
		"@wordpress/env": "^10.32.0",
		"@wordpress/scripts": "^30.25.0",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"wp-scripts lint-js --fix"
		],
		"*.{css,scss,pcss}": [
			"wp-scripts lint-style --fix"
		]
	}
}
